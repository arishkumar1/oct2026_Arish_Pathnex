Day 09 — Docker Integration with Jenkins & GitLab
🔹 Ansible - Setup Docker Container for Ngnix
- name: Setup Docker Container for Nginc
hosts: all
become: yes
tasks: 
   - name: Pull Nginx image 
     docker_image:
    source: Pull
  - name:Run Ngunc Container
    docker_container:
      name: nginx-Container
      image: nginx
      state: started
      published_ports:
       -"8008:80"
🔹 Terraform -EC2 with Auto Scaling Group 
resource "aws_launch_configuration" "example"{
     name = "example-config"
