```yaml
- name: Confifure Auto-healing for Web seerver 
  hosts: all
  tasks:
    - name: Ensure nginx service is running
      service:
         name: nginx
         state: started
        enabled: yes
     - name: Setup auto-restart for nginx service
       lineinfile:
         path: /etc/systemd/system/nginx.service.d/
            override.conf
         line: "Restart=always"
        create: yes
    - name: Reload sysytemd
