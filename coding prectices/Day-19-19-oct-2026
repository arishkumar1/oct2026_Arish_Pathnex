🔹 Kubernetes -Deploy Fluentd for Logging
apiVersion: app/v1
kind: Deployment
metadata: 
   name: Fluentd
spec:
   replicas:1
   selector:
     matchLabels:
       app:Fluentd
  template:
     metadata:
       labels:
         app: Fluentd
    spec:
      containers:
         - name: Fluentd  
           image: fluent/Fluentd
           ports:
              - containerPort: 24224
---
apiVersion: v1 
kind: service
metadata:
     name: Fluentd
spec:
   selector:
      app: Fluentd
    ports:
      - portocol:TCP
        port: 24224
